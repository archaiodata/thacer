VITE_ARCGIS_PROXY=/arcgisproxyportal/proxy.php?u=

# In production, set VITE_ARCGIS_PROXY to the proxy prefix that will be
# served by your webserver. The frontend app will construct ArcGIS queries
# by prefixing the full ArcGIS URL with this value. Example usage:
#   VITE_ARCGIS_PROXY=/arcgisproxyportal/proxy.php?u=
# After setting this, rebuild the frontend (`npm run build`) and deploy the
# `dist` contents to your server.
